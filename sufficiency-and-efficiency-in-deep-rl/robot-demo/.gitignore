# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
!demo/src/env/
!demo/src/env/**

# Testing and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environment files
.env
.env.*

# Logs
*.log

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Downloaded model artifacts and training outputs under demo/model.
demo/model/**/*.bin
demo/model/**/*.ckpt
demo/model/**/*.gguf
demo/model/**/*.h5
demo/model/**/*.index
demo/model/**/*.msgpack
demo/model/**/*.onnx
demo/model/**/*.pb
demo/model/**/*.pt
demo/model/**/*.pth
demo/model/**/*.safetensors
demo/model/**/*.tar
demo/model/**/*.tflite
demo/model/**/*.weights

# Split checkpoint shards and tensor data.
demo/model/**/*.data-*
demo/model/**/*.safetensors.index.json

# Compressed archives commonly used for model distribution.
demo/model/**/*.tar.gz
demo/model/**/*.tgz
demo/model/**/*.zip
demo/model/**/*.7z

# Temporary download and cache outputs.
demo/model/cache/
demo/model/stt/**
demo/model/tts/**
demo/model/vlm/**

# Generated experiment data.
demo/data/**
demo/data/**/*.npz
demo/data/**/*.npy

# Keep model documentation and manifests visible to git.
!demo/model/README.md
!demo/model/manifests/
!demo/model/manifests/**
!demo/model/stt/
!demo/model/stt/.gitkeep
!demo/model/tts/
!demo/model/tts/.gitkeep
!demo/model/vlm/
!demo/model/vlm/.gitkeep
!demo/data/README.md

# UUID-scoped experiment model outputs (snapshots + metadata).
demo/model/*/run_meta.json
demo/model/*/snapshots/**
